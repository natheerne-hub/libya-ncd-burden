__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
# Fresh API pulls are reproducible; the committed snapshot is the source of truth for CI
data/raw/*
!data/raw/.gitkeep
# GBD data may not be redistributed — keep your export local
data/external/*
!data/external/.gitkeep
# Policy brief: fonts are fetched at build time; HTML is an intermediate (PDFs are committed by CI)
docs/brief/fonts/*.ttf
docs/brief/*.html
